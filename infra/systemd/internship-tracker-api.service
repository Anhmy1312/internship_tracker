# /etc/systemd/system/internship-tracker-api.service
# Copy từ repo: infra/systemd/internship-tracker-api.service
#
# Lưu ý: ExecStart phải trỏ file thật.
#   TypeScript đã build  -> /usr/bin/node dist/index.js
#   JavaScript thuần     -> /usr/bin/node src/index.js

[Unit]
Description=Internship Tracker API
Documentation=https://github.com/Anhmy1312/internship_tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/internship-tracker/server

# .env chỉ nằm trên server, KHÔNG commit.
# Không dùng dấu "-" để service FAIL FAST khi thiếu .env (tránh chạy với config rỗng).
EnvironmentFile=/opt/internship-tracker/server/.env
Environment=NODE_ENV=production

# Node 22 LTS cai qua NodeSource (apt) -> /usr/bin/node. Khong dung nvm:
# systemd khong thay node trong ~/.nvm -> status=203/EXEC.
# Repo chua co build step -> chay src/index.js, KHONG phai dist/index.js.
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=internship-tracker-api

# Hardening cơ bản (không phá npm build vì build chạy ngoài unit này)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target

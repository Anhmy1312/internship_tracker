[Unit]
Description=Internship Tracker API
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/internship-tracker/server
EnvironmentFile=/opt/internship-tracker/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
